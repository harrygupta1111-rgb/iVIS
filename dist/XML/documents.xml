<?xml version="1.0" encoding="UTF-8"?>
<documents>
  <!-- Top-level sections. Each section may have either a `file` attribute (single PDF)
       or contain `subdocument` children for multiple PDFs. The `id` is the internal
       docId and should be unique. Filenames are relative to /PDFs/.
       Sections with no `file` and no `subdocument` children are displayed as
       placeholders in the navigation and do nothing when clicked until a PDF is linked. -->

  <!-- 1. User Handbook -->
  <section id="user-handbook" title="User Handbook" file="iVIS - User Handbook (UHB).pdf" />

  <!-- 2. Technical Manual Part 1 (parent folder with two volumes) -->
  <section id="tech-manual-1" title="Technical Manual Part 1">
    <subdocument id="tech-1-1" title="TM Part I – Volume 1" file="iVIS - Technical Manual (TM) Part I - Volume 1.pdf" />
    <subdocument id="tech-1-2" title="TM Part I – Volume 2" file="iVIS - Technical Manual (TM) Part I - Volumn 2.pdf" />
  </section>

  <!-- 3. Technical Manual Part 2 (placeholder – PDF not yet created) -->
  <!-- To link a PDF later, add: file="your-filename.pdf" -->
  <section id="tech-manual-2" title="Technical Manual Part 2" />

  <!-- 4. Technical Manual Part 3 -->
  <section id="tech-manual-3" title="Technical Manual Part 3" file="iVIS - Technical Manual (TM) Part III.pdf" />

  <!-- 5. Technical Manual Part 4 (parent folder with two volumes) -->
  <section id="tech-manual-4" title="Technical Manual Part 4">
    <subdocument id="tech-4-1" title="TM Part IV – Volume 1" file="iVIS - Technical Manual (TM) Part IV - Volume 1.pdf" />
    <subdocument id="tech-4-2" title="TM Part IV – Volume 2" file="iVIS - Technical Manual (TM) Part IV - Volume 2.pdf" />
  </section>

  <!-- 6. Product Tree (placeholder – PDF not yet created) -->
  <!-- To link a PDF later, add: file="your-filename.pdf" -->
  <section id="product-tree" title="Product Tree" />

  <!-- 7. Compliance Matrix -->
  <section id="compliance-matrix" title="Compliance Matrix" file="iVIS - Complience Matrix.pdf" />

  <!-- 8. Draft Acceptance Test Procedure -->
  <section id="draft-atp" title="Draft Acceptance Test Procedure" file="iVIS - Draft Acceptance Test Procedure (ATP).pdf" />

</documents>
